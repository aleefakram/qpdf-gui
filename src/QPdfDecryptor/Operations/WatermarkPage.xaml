<UserControl x:Class="QPdfDecryptor.Operations.WatermarkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QPdfDecryptor.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="32,26,32,30" HorizontalAlignment="Stretch">
            <TextBlock Text="Watermark PDF" FontSize="22" FontWeight="SemiBold" x:Name="PageHeading" />
            <TextBlock Text="Stamp every page with a watermark PDF."
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,18" />

            <controls:RunStatusControl x:Name="Status" />

            <TextBlock Text="WATERMARK PDF" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding WatermarkPdfPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Choose&#x2026;" Margin="8,0,0,0" Click="ChooseWatermark_Click" />
            </Grid>
            <TextBlock Text="Make one in any PDF editor or export it from Word &#x2014; a page-sized PDF with your logo or text works best."
                       FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,0"
                       TextWrapping="Wrap" />

            <TextBlock Text="PLACEMENT" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,20,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="In front of content" GroupName="Placement" Tag="front"
                             IsChecked="True" Checked="Placement_Checked" />
                <RadioButton Content="Behind content" GroupName="Placement" Tag="behind"
                             Margin="16,0,0,0" Checked="Placement_Checked" />
            </StackPanel>

            <TextBlock Text="INPUT PDF" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,20,0,6" />
            <Border MinHeight="88" Padding="20,14" CornerRadius="6" Background="White"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    AllowDrop="True" Drop="DropTarget_Drop" DragEnter="DropTarget_DragEnter">
                <StackPanel>
                    <TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                    <Button Content="Choose _PDF&#x2026;" Click="ChoosePdf_Click" Margin="0,8,0,0"
                            HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Cursor="Hand" />
                </StackPanel>
            </Border>

            <TextBlock Text="SAVE WATERMARKED PDF AS" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,20,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Choose _location&#x2026;" Margin="8,0,0,0" Click="ChooseOutput_Click" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="_Watermark PDF" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunCommand}" Click="Run_Click" />
                <Button Content="_Cancel" Margin="8,0,0,0" x:Name="CancelButton"
                        Visibility="Hidden" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
