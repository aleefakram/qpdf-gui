<UserControl x:Class="QPdfDecryptor.Operations.MergePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QPdfDecryptor.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="32,26,32,30" HorizontalAlignment="Stretch">
            <TextBlock Text="Merge PDFs" FontSize="22" FontWeight="SemiBold"
                       x:Name="PageHeading" />
            <TextBlock Text="Combine several PDFs into one. The list order is the merged order."
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,18" />

            <controls:RunStatusControl x:Name="Status" />

            <TextBlock Text="PDF FILES" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,6" />
            <Border MinHeight="88" Padding="20,14" CornerRadius="6" Background="White"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    AllowDrop="True" Drop="DropTarget_Drop" DragEnter="DropTarget_DragEnter">
                <StackPanel>
                    <ItemsControl x:Name="FileList" ItemsSource="{Binding InputPaths}"
                                  AllowDrop="True" MouseMove="FileList_MouseMove" Drop="FileList_Drop">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,7" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#x2630;" FontSize="13" Margin="0,0,10,0"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons"
                                                FontSize="11" Background="Transparent" BorderThickness="0"
                                                Click="RemoveFile_Click"
                                                AutomationProperties.Name="Remove file" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Add PDFs" Click="AddFiles_Click" Margin="0,8,0,0"
                            HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Cursor="Hand" />
                </StackPanel>
            </Border>

            <TextBlock Text="SAVE MERGED PDF AS" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,20,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Choose _location…" Margin="8,0,0,0" Click="ChooseOutput_Click" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="_Merge PDFs" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunCommand}" Click="Run_Click" />
                <Button Content="_Cancel" Margin="8,0,0,0" x:Name="CancelButton"
                        Visibility="Hidden" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
