<UserControl x:Class="QPdfDecryptor.Operations.CompressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QPdfDecryptor.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="32,26,32,30" HorizontalAlignment="Stretch">
            <TextBlock Text="Compress PDF" FontSize="22" FontWeight="SemiBold" x:Name="PageHeading" />
            <TextBlock Text="Rewrite a PDF so it takes less space."
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,18" />

            <controls:RunStatusControl x:Name="Status" />

            <TextBlock Text="INPUT PDF" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,6" />
            <Border MinHeight="88" Padding="20,14" CornerRadius="6" Background="White"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    AllowDrop="True" Drop="DropTarget_Drop" DragEnter="DropTarget_DragEnter">
                <StackPanel>
                    <TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                    <Button Content="Choose _PDF&#x2026;" Click="ChoosePdf_Click" Margin="0,8,0,0"
                            HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Cursor="Hand" />
                </StackPanel>
            </Border>

            <TextBlock Text="IMAGE QUALITY" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,20,0,6" />
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="QualityPicker" SelectedIndex="1" MinWidth="180"
                          SelectionChanged="QualityPicker_SelectionChanged">
                    <ComboBoxItem Content="Best quality (larger file)" Tag="90" />
                    <ComboBoxItem Content="Balanced" Tag="75" />
                    <ComboBoxItem Content="Smallest file (lower quality)" Tag="50" />
                </ComboBox>
            </StackPanel>
            <TextBlock Text="Photos and scanned pages are re-encoded as JPEG at this quality. Text stays sharp; only images soften."
                       FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,0"
                       TextWrapping="Wrap" />

            <TextBlock Text="MAXIMUM RESOLUTION" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,20,0,6" />
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="ResolutionPicker" SelectedIndex="0" MinWidth="220"
                          SelectionChanged="ResolutionPicker_SelectionChanged">
                    <ComboBoxItem Content="Original (no downsampling)" Tag="0" />
                    <ComboBoxItem Content="300 DPI (safe for print)" Tag="300" />
                    <ComboBoxItem Content="150 DPI (small, stays readable)" Tag="150" />
                    <ComboBoxItem Content="100 DPI (tiny, large text only)" Tag="100" />
                </ComboBox>
            </StackPanel>
            <TextBlock Text="Large scans are scaled down to this resolution before compression. Small pictures and masks are left alone."
                       FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,0"
                       TextWrapping="Wrap" />

            <CheckBox Content="Optimize for web (faster first-page loading)"
                      IsChecked="{Binding LinearizeForWeb}" Margin="0,20,0,0" />

            <TextBlock Text="SAVE COMPRESSED PDF AS" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,20,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Choose _location&#x2026;" Margin="8,0,0,0" Click="ChooseOutput_Click" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="_Compress PDF" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunCommand}" Click="Run_Click" />
                <Button Content="_Cancel" Margin="8,0,0,0" x:Name="CancelButton"
                        Visibility="Hidden" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
