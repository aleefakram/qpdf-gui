<UserControl x:Class="QPdfDecryptor.Operations.DecryptPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid MaxWidth="680" Margin="32,22,32,20" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/qpdf.ico" Width="34" Height="34" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Decrypt a PDF" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Create an unlocked copy using qpdf." Margin="0,4,0,0"
                               Foreground="{StaticResource MutedInkBrush}" FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <Grid MaxWidth="680" Margin="32,26,32,30" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="SetupRegion" Grid.Row="0" Margin="0,0,0,20" Padding="14,12"
                        CornerRadius="4" Background="{StaticResource WarningSurfaceBrush}"
                        BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                        Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                   Foreground="{StaticResource WarningBrush}" Margin="0,1,10,0" />
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="Required PDF component is missing" FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="Reinstall the finished app, or locate the component for this session."
                                       Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="LocateQpdfButton" Grid.Column="2" Content="_Locate component"
                                VerticalAlignment="Center" Click="LocateQpdf_Click" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="What do you want to decrypt?" Style="{StaticResource FormLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton x:Name="SingleFileModeRadio" Content="A single _file"
                                     GroupName="InputMode" IsChecked="True"
                                     Checked="InputMode_Changed" Margin="0,0,24,0" />
                        <RadioButton x:Name="FolderModeRadio" Content="A _folder of files"
                                     GroupName="InputMode" Checked="InputMode_Changed" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="SingleFileSection" Grid.Row="2" Margin="0,20,0,0">
                    <TextBlock Text="Encrypted PDF" Style="{StaticResource FormLabel}" />
                    <Border x:Name="DropTarget"
                            MinHeight="100"
                            Padding="20,18"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            AllowDrop="True"
                            DragEnter="DropTarget_DragEnter"
                            DragLeave="DropTarget_DragLeave"
                            Drop="DropTarget_Drop">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="InputFileName" Text="Drop a PDF here" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="InputFilePath" Text="or choose a file from this computer" Margin="0,5,16,0"
                                           Foreground="{StaticResource MutedInkBrush}" FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:Name="ChooseInputButton" Grid.Column="1" Content="_Choose PDF" Click="ChooseInput_Click"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="FolderInputSection" Grid.Row="2" Margin="0,20,0,0" Visibility="Collapsed">
                    <TextBlock Text="Folder" Style="{StaticResource FormLabel}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderPathInput" IsReadOnly="True"
                                 TextChanged="FolderPathInput_TextChanged" />
                        <Button x:Name="ChooseFolderButton" Grid.Column="2" Content="Choose _folder"
                                Click="ChooseFolder_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="IncludeSubfoldersCheckBox" Content="Include s_ubfolders"
                                  IsChecked="False" Checked="IncludeSubfolders_Changed"
                                  Unchecked="IncludeSubfolders_Changed" />
                        <TextBlock x:Name="FolderFileCount" Margin="16,0,0,0" FontSize="12"
                                   Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,24,0,0">
                    <TextBlock Text="PDF passwords" Style="{StaticResource FormLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton x:Name="SinglePasswordRadio" Content="One password for _all files"
                                     GroupName="PasswordMode" IsChecked="True"
                                     Checked="PasswordMode_Changed" Margin="0,0,24,0" />
                        <RadioButton x:Name="ListPasswordRadio" Content="Try a _list of passwords (.txt)"
                                     GroupName="PasswordMode" Checked="PasswordMode_Changed" />
                    </StackPanel>
                    <Grid x:Name="SinglePasswordSection" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged" />
                            <TextBox x:Name="VisiblePasswordInput" Visibility="Collapsed"
                                     TextChanged="VisiblePasswordInput_TextChanged" />
                        </Grid>
                        <Button x:Name="RevealPasswordButton" Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                AutomationProperties.Name="Show password"
                                ToolTip="Show password" Click="RevealPassword_Click">
                            <TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                    <StackPanel x:Name="ListPasswordSection" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PasswordListPathInput" IsReadOnly="True"
                                     TextChanged="PasswordListPathInput_TextChanged" />
                            <Button x:Name="ChoosePasswordListButton" Grid.Column="2" Content="Choose _list"
                                    Click="ChoosePasswordList_Click" />
                        </Grid>
                        <TextBlock x:Name="PasswordListCount" Margin="0,6,0,0" FontSize="12"
                                   Foreground="{StaticResource MutedInkBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,24,0,0">
                    <StackPanel x:Name="SingleOutputSection">
                        <TextBlock Text="Save decrypted PDF as" Style="{StaticResource FormLabel}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputPathInput" IsReadOnly="True"
                                     TextChanged="OutputPathInput_TextChanged" />
                            <Button x:Name="ChooseOutputButton" Grid.Column="2" Content="Choose _location"
                                    Click="ChooseOutput_Click" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="FolderOutputSection" Visibility="Collapsed">
                        <TextBlock Text="Save decrypted PDFs to" Style="{StaticResource FormLabel}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputFolderInput" IsReadOnly="True"
                                     TextChanged="OutputFolderInput_TextChanged" />
                            <Button x:Name="ChooseOutputFolderButton" Grid.Column="2" Content="Choose _location"
                                    Click="ChooseOutputFolder_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="If a decrypted copy already exists:" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="ConflictPolicyInput" MinWidth="190" SelectedIndex="1">
                                <ComboBoxItem Content="Replace it" />
                                <ComboBoxItem Content="Rename the new copy" />
                                <ComboBoxItem Content="Skip the file" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="5" Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="OpenFolderCheckBox"
                              Content="_Open folder when finished" IsChecked="False"
                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <Button x:Name="CancelButton" Grid.Column="1" Content="_Cancel decryption" Margin="0,0,8,0"
                            Visibility="Hidden" Click="Cancel_Click" />
                    <Button x:Name="DecryptButton" Grid.Column="2" Content="_Decrypt PDF" Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            IsDefault="True" Click="Decrypt_Click" />
                </Grid>

                <StackPanel Grid.Row="6" Margin="0,22,0,0">
                    <Grid x:Name="ProgressRegion" MinHeight="29" Visibility="Hidden">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ProgressText" Text="Decrypting PDF..." FontSize="13" Margin="0,0,0,7" />
                        <ProgressBar x:Name="DecryptProgress" Grid.Row="1" Height="5" Minimum="0" Maximum="100" />
                    </Grid>

                    <Border x:Name="StatusRegion" Visibility="Hidden" Margin="0,14,0,0"
                            MinHeight="64" Padding="14,12" CornerRadius="4"
                            Background="{StaticResource SuccessSurfaceBrush}" Focusable="True"
                            AutomationProperties.LiveSetting="Assertive">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusIcon" Text="&#xE73E;" FontFamily="Segoe Fluent Icons"
                                       FontSize="17" Margin="0,1,10,0" Foreground="{StaticResource SuccessBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                                           Foreground="{StaticResource SuccessBrush}"
                                           AutomationProperties.LiveSetting="Assertive" />
                                <TextBlock x:Name="StatusMessage" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" />
                                <Expander x:Name="DetailsExpander" Header="Technical details" Margin="0,8,0,0" Visibility="Collapsed">
                                    <TextBox x:Name="DetailsText" Margin="0,6,0,0" IsReadOnly="True" TextWrapping="Wrap"
                                             MaxHeight="110" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ResultsRegion" Visibility="Collapsed" Margin="0,14,0,0" Padding="14,12"
                            CornerRadius="4" Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Focusable="True" AutomationProperties.LiveSetting="Polite">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="ResultsSummary" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                <Button x:Name="ExportReportButton" Content="Export report (_CSV)"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="ExportReport_Click" Visibility="Collapsed" />
                            </Grid>
                            <ItemsControl x:Name="ResultsList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="15"
                                                       Foreground="{Binding IconBrush}" Margin="0,1,10,0"
                                                       VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding InputPath}" />
                                                <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{StaticResource MutedInkBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PasswordDisplay}" FontFamily="Consolas" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,2,0" />
                                                <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                                        Visibility="{Binding HasPassword, Converter={StaticResource BoolToVisibility}}"
                                                        Click="RevealResultPassword_Click" ToolTip="Show matched password"
                                                        AutomationProperties.Name="Show matched password">
                                                    <TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
