<UserControl x:Class="QPdfDecryptor.Operations.RotatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QPdfDecryptor.Controls">
    <UserControl.Resources>
        <Style x:Key="SegmentedAngle" TargetType="RadioButton">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="32,26,32,30" HorizontalAlignment="Stretch">
            <TextBlock Text="Rotate pages" FontSize="22" FontWeight="SemiBold" x:Name="PageHeading" />
            <TextBlock Text="Turn pages left or right in 90&#xB0; steps."
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,18" />

            <controls:RunStatusControl x:Name="Status" />

            <TextBlock Text="INPUT PDF" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,6" />
            <Border MinHeight="88" Padding="20,14" CornerRadius="6" Background="White"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    AllowDrop="True" Drop="DropTarget_Drop" DragEnter="DropTarget_DragEnter">
                <StackPanel>
                    <TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                    <Button Content="Choose _PDF&#x2026;" Click="ChoosePdf_Click" Margin="0,8,0,0"
                            HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Cursor="Hand" />
                </StackPanel>
            </Border>

            <TextBlock Text="DIRECTION" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,20,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentedAngle}" GroupName="Angle" Tag="-90"
                             Content="&#x21B6; 90&#xB0; left" Checked="Angle_Checked" />
                <RadioButton Style="{StaticResource SegmentedAngle}" GroupName="Angle" Tag="90"
                             Content="&#x21B7; 90&#xB0; right" IsChecked="True" Checked="Angle_Checked" />
                <RadioButton Style="{StaticResource SegmentedAngle}" GroupName="Angle" Tag="180"
                             Content="180&#xB0;" Checked="Angle_Checked" />
            </StackPanel>

            <TextBlock Text="PAGES" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,20,0,6" />
            <TextBox Text="{Binding PageRange, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Leave empty for every page &#x2014; e.g. 1-3,7 or z-3" FontSize="12"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding RangeError}" FontSize="12"
                       Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0" />

            <TextBlock Text="SAVE ROTATED PDF AS" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,20,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Choose _location&#x2026;" Margin="8,0,0,0" Click="ChooseOutput_Click" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="_Rotate pages" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunCommand}" Click="Run_Click" />
                <Button Content="_Cancel" Margin="8,0,0,0" x:Name="CancelButton"
                        Visibility="Hidden" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
