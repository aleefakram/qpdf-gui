<UserControl x:Class="QPdfDecryptor.Operations.SplitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QPdfDecryptor.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="32,26,32,30" HorizontalAlignment="Stretch">
            <TextBlock Text="Split PDF" FontSize="22" FontWeight="SemiBold"
                       x:Name="PageHeading" />
            <TextBlock Text="Break a PDF into smaller files."
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,18" />

            <controls:RunStatusControl x:Name="Status" />

            <TextBlock Text="INPUT PDF" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,6" />
            <Border MinHeight="88" Padding="20,14" CornerRadius="6" Background="White"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    AllowDrop="True" Drop="DropTarget_Drop" DragEnter="DropTarget_DragEnter">
                <StackPanel>
                    <TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" />
                    <Button Content="Choose _PDF&#x2026;" Click="ChoosePdf_Click" Margin="0,8,0,0"
                            HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Cursor="Hand" />
                </StackPanel>
            </Border>

            <TextBlock Text="SPLIT EVERY" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,20,0,6" />
            <StackPanel Orientation="Horizontal">
                <Button Content="&#x2212;" Width="36" Click="FewerPages_Click"
                        AutomationProperties.Name="Fewer pages per file" />
                <TextBlock Text="{Binding PagesPerFile}" MinWidth="52" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="8,0" />
                <Button Content="+" Width="36" Click="MorePages_Click"
                        AutomationProperties.Name="More pages per file" />
            </StackPanel>
            <TextBlock x:Name="EstimateHint" FontSize="12" Foreground="{StaticResource MutedInkBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

            <TextBlock Text="SAVE SPLIT FILES TO" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,20,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Choose _folder&#x2026;" Margin="8,0,0,0" Click="ChooseFolder_Click" />
            </Grid>

            <TextBlock Text="FILE NAMES START WITH" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,20,0,6" />
            <TextBox Text="{Binding OutputStem, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="(&#x2212;first&#x2212;last is appended automatically)" FontSize="12"
                       Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="_Split PDFs" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunCommand}" Click="Run_Click" />
                <Button Content="_Cancel" Margin="8,0,0,0" x:Name="CancelButton"
                        Visibility="Hidden" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
