<Window x:Class="QPdfDecryptor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Ninja"
        Icon="Assets/qpdf.ico"
        Width="900" Height="720" MinWidth="740" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="NavList" Grid.Column="0"
                 Background="#FFF4F6F6" BorderThickness="0,0,1,0"
                 SelectionChanged="NavList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="22,12,0,4"
                                       FontSize="11" FontWeight="SemiBold" Opacity="0.65" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                    <Setter Property="Padding" Value="18,9" />
                    <Setter Property="Margin" Value="8,2" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Root" Background="Transparent" CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2"
                                                Background="{StaticResource PrimaryBrush}"
                                                HorizontalAlignment="Left" Margin="-14,0,0,0"
                                                Visibility="Collapsed" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#FFEBEFEF" />
                                        <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="15"
                                   Margin="0,0,11,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />
    </Grid>
</Window>
